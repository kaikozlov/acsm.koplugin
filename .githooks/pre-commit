#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

run_check() {
    local label="$1"
    shift

    local output
    output="$(mktemp)"
    if "$@" >"$output" 2>&1; then
        rm -f "$output"
        return 0
    fi

    local status=$?
    echo "[pre-commit] ${label} failed:" >&2
    cat "$output" >&2
    rm -f "$output"
    return "$status"
}

run_check "Lua formatting" just fmt-check
run_check "luacheck" just lint
run_check "tests" just test

echo "[pre-commit] Checks passed."
